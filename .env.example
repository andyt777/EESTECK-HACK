# FileGrid PPC — environment template (placeholders only, NO real secrets).
#
# Do not copy this file by hand: run scripts/init-env.sh (or start.sh / start.ps1).
# It creates .env and replaces every __GENERATE_*__ placeholder with a strong
# random value. If .env already exists, only the missing variables are appended.
# .env is git-ignored and must never be committed.

# --- Gateway (published ports; change them if they are already in use) ---
# HTTP only redirects to HTTPS. 8080 is the default because port 80 is often
# taken on Windows (IIS / http.sys).
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=443

# --- Worker layout: full = one worker per category, lite = a single worker-all ---
# start.sh --lite / start.ps1 --lite / make up-lite override this for one run.
COMPOSE_PROFILES=full

# --- Backend memory: container limit + explicit JVM sizes (heap, direct, metaspace, code cache) ---
# The JVM parts must add up to less than the container limit.
API_MEMORY_LIMIT=704M
API_JAVA_OPTS="-Xmx320m -XX:MaxDirectMemorySize=64m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -Xss512k -XX:+UseG1GC"
# worker-meter, worker-fault, worker-document
WORKER_MEMORY_LIMIT=576M
WORKER_JAVA_OPTS="-Xmx208m -XX:MaxDirectMemorySize=48m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -Xss512k -XX:+UseG1GC"
WORKER_CONCURRENCY=4
# Jobs a worker consumer holds unacknowledged (1 = a long transfer never delays other jobs)
WORKER_PREFETCH=1
# worker-video (and worker-all in lite mode): large files, few transfers at a time
WORKER_VIDEO_MEMORY_LIMIT=640M
WORKER_VIDEO_JAVA_OPTS="-Xmx224m -XX:MaxDirectMemorySize=96m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -Xss512k -XX:+UseG1GC"
WORKER_VIDEO_CONCURRENCY=2

# --- Postgres tuning (meta-db and store-db) ---
PG_SHARED_BUFFERS=64MB
PG_MAX_CONNECTIONS=50
PG_WORK_MEM=4MB

# --- meta-db (metadata, audit, incidents) ---
META_DB_USER=filegrid_meta
META_DB_PASSWORD=__GENERATE_HEX_24__

# --- store-db (the "Database" storage, separate instance) ---
STORE_DB_USER=filegrid_store
STORE_DB_PASSWORD=__GENERATE_HEX_24__

# --- s3 (MinIO): root is used only by minio-init; FileGrid uses the service user ---
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=__GENERATE_HEX_24__
S3_ACCESS_KEY=filegrid-service
S3_SECRET_KEY=__GENERATE_HEX_24__

# --- ftp (pure-ftpd) service user ---
FTP_USER=filegrid
FTP_PASSWORD=__GENERATE_HEX_24__

# --- rabbitmq ---
RABBITMQ_USER=filegrid
RABBITMQ_PASSWORD=__GENERATE_HEX_24__

# --- grafana admin (https://localhost/grafana) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE_HEX_24__

# --- Stage 8: observability (docs/OBSERVABILITY.md) ---
# Backend log format on stdout -> Alloy -> Loki: logstash (JSON with traceId/fileId/category/storage) or ecs.
LOG_FORMAT=logstash
# OpenTelemetry Java agent in api and workers (traces -> Alloy -> Tempo); false = no tracing, less memory.
OTEL_JAVAAGENT_ENABLED=true
# Sampling of new traces (OpenTelemetry sampler name): parentbased_always_on (all) or parentbased_always_off.
OTEL_TRACES_SAMPLER=parentbased_always_on
# Simulator tracing (Python SDK); true = off.
OTEL_SDK_DISABLED=false

# --- Key-encryption key for personal-data envelope encryption (Stage 7): 256 bit, base64 ---
FILEGRID_KEK=__GENERATE_BASE64_32__
# Id of the current KEK (saved with every wrapped data key) and older KEKs for rotation: id:base64,...
FILEGRID_KEK_ID=kek-1
FILEGRID_KEK_PREVIOUS=

# --- Agent 01: routing policy check interval and storage health freshness ---
FILEGRID_POLICY_CHECK_INTERVAL=10s
FILEGRID_ROUTING_HEALTH_MAX_AGE=30s

# --- Stage 4: upload pipeline ---
# Largest upload accepted (tus and multipart), in bytes (5 GB).
FILEGRID_UPLOAD_MAX_BYTES=5368709120
# How often PENDING files are re-examined (resumed as soon as a storage is UP again).
FILEGRID_INGESTION_RECOVERY_INTERVAL=30s

# --- Stage 5: smart meter simulator (make sim-normal / sim-peak / sim-storm) ---
# normal | peak (x10) | storm (normal + x10 bursts); make sim-* overrides it for one run.
SIM_MODE=normal
SIM_METERS=2000
# Real seconds between two readings of the same meter (2000 meters / 60 s = 2000 readings/min).
SIM_INTERVAL_SECONDS=60
# Empty = 1 (normal, storm) or 10 (peak).
SIM_RATE_MULTIPLIER=
# Accelerated clock: >1 sends readings faster (whole simulated days in minutes).
SIM_TIME_SCALE=1
# Seconds to run; empty = forever.
SIM_DURATION=
SIM_BATCH_SIZE=250
SIM_CONCURRENCY=4
# Share of readings deliberately sent again (FileGrid must reject them as duplicates).
SIM_DUPLICATE_RATE=0.01
SIM_SEED=42
SIM_MEMORY_LIMIT=160M

# --- Security & Incident Center (WhatsApp) -----------------------------------
# SIMULATED (demo: messages only shown in the UI), PREPARED_ONLY or REAL (Twilio).
NOTIFY_MODE=SIMULATED
# Optional: one escalation delay for every severity (e.g. 2m for a demo).
NOTIFY_ESCALATION_OVERRIDE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Phone numbers per role (E.164). Never commit real numbers.
NOTIFY_CONTACT_DISPATCH=
NOTIFY_CONTACT_TECH_MANAGER=
NOTIFY_CONTACT_FIELD_TEAM=
NOTIFY_CONTACT_IT_SECURITY=
NOTIFY_CONTACT_PLATFORM_ADMIN=
# --- PPCastor on real WhatsApp (ADR-0008, README "WhatsApp real") ---
# Needs NOTIFY_MODE=REAL and the TWILIO_* values above. Only the numbers in NOTIFY_CONTACT_* may talk to PPCastor.
# Public URL of the webhook, exactly as set in the Twilio sandbox ("When a message comes in"), e.g.
# https://<name>.trycloudflare.com/api/whatsapp/inbound (docker compose --profile tunnel up -d tunnel).
WHATSAPP_WEBHOOK_URL=
# Keycloak client of the WhatsApp channel (role svc-whatsapp: assistant + voice reports, never personal data).
KC_WHATSAPP_CLIENT_ID=filegrid-whatsapp
KC_WHATSAPP_SECRET=__GENERATE_HEX_24__
# Model that transcribes WhatsApp voice notes (Gemini; empty = LLM_MODEL).
VOICE_TRANSCRIBE_MODEL=

# --- intelligence (Agent 02, AI Operations Assistant, field voice) ---
# Empty ANTHROPIC_API_KEY = the assistant runs in SIMULATED mode (deterministic, still uses real data).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
# Alternative LLM for the assistant: gemini | ollama | openai (OpenAI-compatible API). Empty = Anthropic if ANTHROPIC_API_KEY is set, else SIMULATED.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
INTELLIGENCE_ANALYSIS_INTERVAL_SECONDS=60
INTELLIGENCE_WINDOW_HOURS=24
INTELLIGENCE_INCIDENT_MIN_CONFIDENCE=0.8
INTELLIGENCE_MEMORY_LIMIT=384M
# simulated | twilio (twilio is a stub; real calls are never placed in this build)
VOICE_PROVIDER=simulated
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN: set once, in the WhatsApp section above (a duplicate key here
# would silently override them with an empty value).
TWILIO_FROM_NUMBER=

# --- Stage 11: Keycloak service accounts (client_credentials) for the simulator and intelligence ---
# Shared with the backend/realm setup; the secrets must match the clients in the filegrid realm.
KC_TOKEN_URL=http://keycloak:8080/auth/realms/filegrid/protocol/openid-connect/token
KC_SIMULATOR_CLIENT_ID=filegrid-simulator
KC_SIMULATOR_SECRET=__GENERATE_HEX_24__
KC_INTELLIGENCE_CLIENT_ID=filegrid-intelligence
KC_INTELLIGENCE_SECRET=__GENERATE_HEX_24__

# --- Stage 11: Keycloak (identity provider, https://localhost/auth) ---
# The realm (clients, roles, demo users) is imported from infra/keycloak/realm-filegrid.json
# on the FIRST start only: secrets and passwords changed later here are not re-imported
# (see README, "Autentificare", for the reset procedure).
KC_MEMORY_LIMIT=768M
# Public URL of Keycloak; must match the browser origin (add the port if GATEWAY_HTTPS_PORT is not 443).
KC_PUBLIC_URL=https://localhost/auth
# Issuer the api expects in browser tokens (= KC_PUBLIC_URL + /realms/filegrid).
FILEGRID_OIDC_ISSUER=https://localhost/auth/realms/filegrid
# meta-db hosts the `keycloak` database too: role password and a larger connection limit.
KC_DB_PASSWORD=__GENERATE_HEX_24__
META_DB_MAX_CONNECTIONS=80
# Bootstrap admin of the master realm (the admin console is not routed through the gateway).
KC_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=__GENERATE_HEX_24__
# Alertmanager -> api webhook (client_credentials).
KC_ALERTMANAGER_SECRET=__GENERATE_HEX_24__
# Demo users (filegrid realm): field.demo, dispatcher.demo, connections.demo, analyst.demo,
# incident-manager.demo, admin.demo. Only connections.demo and admin.demo may read personal data.
KC_DEMO_FIELD_PASSWORD=__GENERATE_HEX_24__
KC_DEMO_DISPATCHER_PASSWORD=__GENERATE_HEX_24__
KC_DEMO_CONNECTIONS_PASSWORD=__GENERATE_HEX_24__
KC_DEMO_ANALYST_PASSWORD=__GENERATE_HEX_24__
KC_DEMO_INCIDENT_MANAGER_PASSWORD=__GENERATE_HEX_24__
KC_DEMO_ADMIN_PASSWORD=__GENERATE_HEX_24__
# HMAC key (256 bit, base64) for short-lived signed download/preview links.
FILEGRID_LINK_KEY=__GENERATE_BASE64_32__
