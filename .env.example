# FileGrid PPC — environment template (placeholders only, NO real secrets).
#
# Do not copy this file by hand: run scripts/init-env.sh (or start.sh / start.ps1).
# It creates .env and replaces every __GENERATE_*__ placeholder with a strong
# random value. If .env already exists, only the missing variables are appended.
# .env is git-ignored and must never be committed.

# --- Gateway (published ports; change them if they are already in use) ---
# HTTP only redirects to HTTPS. 8080 is the default because port 80 is often
# taken on Windows (IIS / http.sys).
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=443

# --- Worker layout: full = one worker per category, lite = a single worker-all ---
# start.sh --lite / start.ps1 --lite / make up-lite override this for one run.
COMPOSE_PROFILES=full

# --- Backend memory: container limit + explicit JVM sizes (heap, direct, metaspace, code cache) ---
# The JVM parts must add up to less than the container limit.
API_MEMORY_LIMIT=640M
API_JAVA_OPTS="-Xmx320m -XX:MaxDirectMemorySize=64m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=64m -Xss512k -XX:+UseG1GC"
# worker-meter, worker-fault, worker-document
WORKER_MEMORY_LIMIT=448M
WORKER_JAVA_OPTS="-Xmx208m -XX:MaxDirectMemorySize=48m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=64m -Xss512k -XX:+UseG1GC"
WORKER_CONCURRENCY=4
# worker-video (and worker-all in lite mode): large files, few transfers at a time
WORKER_VIDEO_MEMORY_LIMIT=512M
WORKER_VIDEO_JAVA_OPTS="-Xmx224m -XX:MaxDirectMemorySize=96m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=64m -Xss512k -XX:+UseG1GC"
WORKER_VIDEO_CONCURRENCY=2

# --- Postgres tuning (meta-db and store-db) ---
PG_SHARED_BUFFERS=64MB
PG_MAX_CONNECTIONS=50
PG_WORK_MEM=4MB

# --- meta-db (metadata, audit, incidents) ---
META_DB_USER=filegrid_meta
META_DB_PASSWORD=__GENERATE_HEX_24__

# --- store-db (the "Database" storage, separate instance) ---
STORE_DB_USER=filegrid_store
STORE_DB_PASSWORD=__GENERATE_HEX_24__

# --- s3 (MinIO): root is used only by minio-init; FileGrid uses the service user ---
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=__GENERATE_HEX_24__
S3_ACCESS_KEY=filegrid-service
S3_SECRET_KEY=__GENERATE_HEX_24__

# --- ftp (pure-ftpd) service user ---
FTP_USER=filegrid
FTP_PASSWORD=__GENERATE_HEX_24__

# --- rabbitmq ---
RABBITMQ_USER=filegrid
RABBITMQ_PASSWORD=__GENERATE_HEX_24__

# --- grafana admin (https://localhost/grafana) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE_HEX_24__

# --- Key-encryption key for personal-data envelope encryption (Stage 7): 256 bit, base64 ---
FILEGRID_KEK=__GENERATE_BASE64_32__
