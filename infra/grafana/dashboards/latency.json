          "expr": "histogram_quantile(0.5, sum by (le, category, storage) (rate(filegrid_store_duration_seconds_bucket{category=~\"$category\", storage=~\"$storage\", outcome=\"verified\"}[5m])))",
          "legendFormat": "{{category}} → {{storage}}"
