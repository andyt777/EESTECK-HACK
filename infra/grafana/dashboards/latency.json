{
  "uid": "filegrid-latency",
  "title": "FileGrid — Latență, throughput și erori (categorie × storage)",
  "tags": [
    "filegrid",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
