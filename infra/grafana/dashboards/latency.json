  "templating": {
    "list": [
      {
        "name": "category",
        "label": "Categorie",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(filegrid_operations_total, category)",
          "refId": "v"
        },
        "definition": "label_values(filegrid_operations_total, category)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "storage",
        "label": "Storage",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(filegrid_operations_total, storage)",
          "refId": "v"
        },
        "definition": "label_values(filegrid_operations_total, storage)",
